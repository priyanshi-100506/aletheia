# ALETHEIA — Environment Variable Reference
# Copy this file to `.env` and fill in the values.
# Never commit `.env` to version control.

# ── Database ──────────────────────────────────────────────────────────────────
# Async PostgreSQL connection string.
# In Docker Compose the host is the service name ("postgres"), not "localhost".
DATABASE_URL=postgresql+asyncpg://aletheia_user:aletheia_password@localhost:5435/aletheia_db

# ── AI ────────────────────────────────────────────────────────────────────────
# Required. Get your key at https://ai.google.dev/
GEMINI_API_KEY=

# Gemini model to use. Default is gemini-2.0-flash (fast, cheap).
# Other options: gemini-1.5-pro, gemini-2.0-pro
GEMINI_MODEL=gemini-2.0-flash

# ── GitHub ────────────────────────────────────────────────────────────────────
# Required for real PR creation. Generate at https://github.com/settings/tokens
# Needs: repo (full), workflow
GITHUB_TOKEN=

# No incident target fallback is permitted. The repository comes from each
# allowlisted incident payload; this legacy value is intentionally ignored.
GITHUB_REPOSITORY=

# Base branch for all PRs (typically "main" or "master")
GITHUB_BASE_BRANCH=main

# Absolute path to the local Git checkout ALETHEIA will patch
REPO_PATH=.

# ── Security ──────────────────────────────────────────────────────────────────
# API key for authenticating frontend ↔ backend requests.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_KEY=

# HMAC SHA-256 secret for validating inbound webhook payloads.
# Must match the secret configured in your monitoring tool (Datadog, Prometheus, etc.)
WEBHOOK_SECRET=

# ── Redis / Queue ─────────────────────────────────────────────────────────────
# Redis connection URL. In Docker Compose, use: redis://redis:6379/0
REDIS_URL=redis://127.0.0.1:6379/0

# Number of concurrent job coroutines in the ARQ worker process
WORKER_CONCURRENCY=4

# How long finished job results stay in Redis before expiry (seconds, default 24h)
REDIS_JOB_TTL=86400

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_MAX_REQUESTS=30
RATE_LIMIT_WINDOW_SECONDS=60
IDEMPOTENCY_TTL_SECONDS=3600

# ── Runtime ───────────────────────────────────────────────────────────────────
# Set to "production" to enforce API key checks and fail-fast on missing config.
ENVIRONMENT=development
